{
  "name": "@rds/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --import ./register.mjs dist/apps/api/src/index.js",
    "db:migrate": "tsx src/infrastructure/db/migrate.ts",
    "db:seed": "tsx src/seeds/devSeed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@rds/core": "1.0.0",
    "@rds/shared": "1.0.0",
    "hono": "^4.8.0",
    "jose": "^6.0.0",
    "mysql2": "^3.14.0",
    "xlsx": "^0.18.5",
    "zod": "^4.0.0"
  }
}
